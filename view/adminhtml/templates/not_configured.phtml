/** @var \Magento\Backend\Block\Template $block */
/** @var \Magento\Framework\Escaper $escaper */
/** @var \DmLab\CatalogEnrich\ViewModel\TypeSafeStatus $viewModel */
$viewModel = $block->getData('view_model');
$message = $viewModel->getNotConfiguredMessage();
?>
<?php if ($message !== null): ?>
    <div class="messages">
        <div class="message message-warning warning">
            <div><?= $escaper->escapeHtml($message) ?></div>
        </div>
    </div>
<?php endif; ?>
