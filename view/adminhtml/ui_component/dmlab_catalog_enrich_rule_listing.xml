<listing xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_configuration.xsd">
    <argument name="data" xsi:type="array">
        <item name="js_config" xsi:type="array">
            <item name="provider" xsi:type="string">dmlab_catalog_enrich_rule_listing.dmlab_catalog_enrich_rule_listing_data_source</item>
        </item>
    </argument>
    <settings>
        <buttons>
            <button name="add">
                <url path="*/*/new"/>
                <class>primary</class>
                <label translate="true">Add New Rule</label>
            </button>
        </buttons>
        <spinner>dmlab_catalog_enrich_rule_columns</spinner>
        <deps>
            <dep>dmlab_catalog_enrich_rule_listing.dmlab_catalog_enrich_rule_listing_data_source</dep>
        </deps>
    </settings>
    <dataSource name="dmlab_catalog_enrich_rule_listing_data_source" component="Magento_Ui/js/grid/provider">
        <settings>
            <storageConfig>
                <param name="indexField" xsi:type="string">rule_id</param>
            </storageConfig>
            <updateUrl path="mui/index/render"/>
        </settings>
        <aclResource>DmLab_CatalogEnrich::rules</aclResource>
        <dataProvider class="Magento\Framework\View\Element\UiComponent\DataProvider\DataProvider"
                      name="dmlab_catalog_enrich_rule_listing_data_source">
            <settings>
                <requestFieldName>id</requestFieldName>
                <primaryFieldName>rule_id</primaryFieldName>
            </settings>
        </dataProvider>
    </dataSource>
    <listingToolbar name="listing_top">
        <settings>
            <sticky>true</sticky>
        </settings>
        <bookmark name="bookmarks"/>
        <columnsControls name="columns_controls"/>
        <filters name="listing_filters"/>
        <massaction name="listing_massaction">
            <action name="delete">
                <settings>
                    <confirm>
                        <message translate="true">Are you sure you want to delete the selected rules?</message>
                        <title translate="true">Delete rules</title>
                    </confirm>
                    <url path="dmlab_catalog_enrich/rule/massDelete"/>
                    <type>delete</type>
                    <label translate="true">Delete</label>
                </settings>
            </action>
        </massaction>
        <paging name="listing_paging"/>
    </listingToolbar>
    <columns name="dmlab_catalog_enrich_rule_columns">
        <selectionsColumn name="ids">
            <settings>
                <indexField>rule_id</indexField>
            </settings>
        </selectionsColumn>
        <column name="rule_id">
            <settings>
                <filter>textRange</filter>
                <label translate="true">ID</label>
                <sorting>asc</sorting>
            </settings>
        </column>
        <column name="attribute_label" class="DmLab\CatalogEnrich\Ui\Component\Listing\Column\AttributeLabel">
            <settings>
                <filter>text</filter>
                <label translate="true">Attribute</label>
            </settings>
        </column>
        <column name="mode" component="Magento_Ui/js/grid/columns/select">
            <settings>
                <options class="DmLab\CatalogEnrich\Model\Rule\Source\Mode"/>
                <filter>select</filter>
                <dataType>select</dataType>
                <label translate="true">Mode</label>
            </settings>
        </column>
        <column name="status" class="DmLab\CatalogEnrich\Ui\Component\Listing\Column\RuleStatus">
            <settings>
                <label translate="true">Status</label>
                <sortable>false</sortable>
            </settings>
        </column>
        <column name="outcomes" class="DmLab\CatalogEnrich\Ui\Component\Listing\Column\RuleOutcomes">
            <settings>
                <label translate="true">Attempt Outcomes</label>
                <sortable>false</sortable>
            </settings>
        </column>
        <column name="threshold">
            <settings>
                <filter>textRange</filter>
                <label translate="true">Threshold</label>
            </settings>
        </column>
        <column name="fill_mode" component="Magento_Ui/js/grid/columns/select">
            <settings>
                <options class="DmLab\CatalogEnrich\Model\Rule\Source\FillMode"/>
                <filter>select</filter>
                <dataType>select</dataType>
                <label translate="true">Fill Mode</label>
            </settings>
        </column>
        <column name="updated_at" class="Magento\Ui\Component\Listing\Columns\Date"
                component="Magento_Ui/js/grid/columns/date">
            <settings>
                <filter>dateRange</filter>
                <dataType>date</dataType>
                <label translate="true">Updated</label>
            </settings>
        </column>
        <actionsColumn name="actions" class="DmLab\CatalogEnrich\Ui\Component\Listing\Column\RuleActions">
            <settings>
                <indexField>rule_id</indexField>
            </settings>
        </actionsColumn>
    </columns>
</listing>
