{
    "name": "dmlab/module-catalog-enrich",
    "description": "AI product attribute enrichment for Magento 2: fills empty select, multiselect and Yes/No attributes (layered navigation filters) from product descriptions, with review queue, auto-apply and revert.",
    "keywords": [
        "magento2",
        "magento2-module",
        "magento 2",
        "ai",
        "llm",
        "product attributes",
        "attribute enrichment",
        "catalog enrichment",
        "product data quality",
        "layered navigation",
        "filters",
        "pim",
        "typesafe",
        "jev"
    ],
    "type": "magento2-module",
    "license": "OSL-3.0",
    "homepage": "https://github.com/dmlab-work/module-catalog-enrich",
    "support": {
        "issues": "https://github.com/dmlab-work/module-catalog-enrich/issues",
        "source": "https://github.com/dmlab-work/module-catalog-enrich"
    },
    "version": "0.0.2",
    "require": {
        "php": "~8.2.0||~8.3.0||~8.4.0||~8.5.0",
        "dmlab/module-typesafe-core": "^0.0.2",
        "magento/framework": "^103.0.7",
        "magento/framework-message-queue": "^100.4.7",
        "magento/module-backend": "^102.0.7",
        "magento/module-catalog": "^104.0.7",
        "magento/module-config": "^101.2.7",
        "magento/module-eav": "^102.1.7",
        "magento/module-indexer": "^100.4.7",
        "magento/module-mysql-mq": "^100.4.5",
        "magento/module-store": "^101.1.7",
        "magento/module-ui": "^101.2.7",
        "psr/log": "^2.0||^3.0",
        "symfony/console": "^6.4||^7.4"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5||^12.5"
    },
    "autoload": {
        "files": [
            "registration.php"
        ],
        "psr-4": {
            "DmLab\\CatalogEnrich\\": ""
        }
    }
}
