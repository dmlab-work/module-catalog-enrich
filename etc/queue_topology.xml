<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework-message-queue:etc/topology.xsd">
    <exchange name="magento-db" type="topic" connection="db">
        <binding id="dmlabCatalogEnrichProducts" topic="dmlab.catalog_enrich.products"
                 destinationType="queue" destination="dmlab.catalog_enrich.products"/>
        <binding id="dmlabCatalogEnrichSuggestions" topic="dmlab.catalog_enrich.suggestions"
                 destinationType="queue" destination="dmlab.catalog_enrich.suggestions"/>
    </exchange>
</config>
