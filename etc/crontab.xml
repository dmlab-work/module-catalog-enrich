<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Cron:etc/crontab.xsd">
    <group id="default">
        <job name="dmlab_catalog_enrich_nightly" instance="DmLab\CatalogEnrich\Cron\NightlyEnrich" method="execute">
            <schedule>0 2 * * *</schedule>
        </job>
        <job name="dmlab_catalog_enrich_requeue_deferred" instance="DmLab\CatalogEnrich\Cron\RequeueDeferred"
             method="execute">
            <schedule>15 * * * *</schedule>
        </job>
    </group>
</config>
