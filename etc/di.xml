<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <type name="Magento\Framework\Console\CommandListInterface">
        <arguments>
            <argument name="commands" xsi:type="array">
                <item name="dmlab_catalog_enrich_run" xsi:type="object">DmLab\CatalogEnrich\Console\Command\RunCommand</item>
                <item name="dmlab_catalog_enrich_calibrate" xsi:type="object">DmLab\CatalogEnrich\Console\Command\CalibrateCommand</item>
                <item name="dmlab_catalog_enrich_report" xsi:type="object">DmLab\CatalogEnrich\Console\Command\ReportCommand</item>
            </argument>
        </arguments>
    </type>
    <!-- Proxies keep bin/magento bootstrap free of config/DB access. -->
    <type name="DmLab\CatalogEnrich\Console\Command\RunCommand">
        <arguments>
            <argument name="productSelector" xsi:type="object">DmLab\CatalogEnrich\Model\Run\ProductSelector\Proxy</argument>
            <argument name="enricher" xsi:type="object">DmLab\CatalogEnrich\Model\Run\Enricher\Proxy</argument>
            <argument name="lastRunStore" xsi:type="object">DmLab\CatalogEnrich\Model\Run\LastRunStore\Proxy</argument>
        </arguments>
    </type>
    <type name="DmLab\CatalogEnrich\Console\Command\CalibrateCommand">
        <arguments>
            <argument name="calibrator" xsi:type="object">DmLab\CatalogEnrich\Model\Calibration\Calibrator\Proxy</argument>
        </arguments>
    </type>
    <type name="DmLab\CatalogEnrich\Console\Command\ReportCommand">
        <arguments>
            <argument name="reportBuilder" xsi:type="object">DmLab\CatalogEnrich\Model\Report\ReportBuilder\Proxy</argument>
        </arguments>
    </type>
    <type name="DmLab\CatalogEnrich\Model\ResourceModel\Rule\Grid\Collection">
        <arguments>
            <argument name="mainTable" xsi:type="string">dmlab_catalog_enrich_rule</argument>
            <argument name="resourceModel" xsi:type="string">DmLab\CatalogEnrich\Model\ResourceModel\Rule</argument>
        </arguments>
    </type>
    <type name="DmLab\CatalogEnrich\Model\ResourceModel\Suggestion\Grid\Collection">
        <arguments>
            <argument name="mainTable" xsi:type="string">dmlab_catalog_enrich_suggestion</argument>
            <argument name="resourceModel" xsi:type="string">DmLab\CatalogEnrich\Model\ResourceModel\Suggestion</argument>
        </arguments>
    </type>
    <type name="DmLab\CatalogEnrich\Model\ResourceModel\Attempt\Grid\Collection">
        <arguments>
            <argument name="mainTable" xsi:type="string">dmlab_catalog_enrich_attempt</argument>
            <argument name="resourceModel" xsi:type="string">DmLab\CatalogEnrich\Model\ResourceModel\Attempt</argument>
        </arguments>
    </type>
    <type name="Magento\Framework\View\Element\UiComponent\DataProvider\CollectionFactory">
        <arguments>
            <argument name="collections" xsi:type="array">
                <item name="dmlab_catalog_enrich_rule_listing_data_source" xsi:type="string">DmLab\CatalogEnrich\Model\ResourceModel\Rule\Grid\Collection</item>
                <item name="dmlab_catalog_enrich_suggestion_listing_data_source" xsi:type="string">DmLab\CatalogEnrich\Model\ResourceModel\Suggestion\Grid\Collection</item>
                <item name="dmlab_catalog_enrich_attempt_listing_data_source" xsi:type="string">DmLab\CatalogEnrich\Model\ResourceModel\Attempt\Grid\Collection</item>
            </argument>
        </arguments>
    </type>
</config>
